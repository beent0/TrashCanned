        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    UTILIZADORES {\n        int id PK\n        varchar nome\n        varchar email UK\n        varchar password_hash\n        varchar role\n        boolean ativo\n        varchar empresa\n        int gerido_por_id FK\n        timestamptz criado_em\n    }\n\n    CONTENTORES {\n        varchar id PK\n        varchar zona\n        decimal latitude\n        decimal longitude\n        float capacidade\n        float nivel_atual\n        float limiar_aviso\n        float limiar_critico\n        timestamptz ultima_recolha\n        int gerido_por_id FK\n    }\n\n    SENSORES {\n        varchar id PK\n        varchar contentor_id FK\n        varchar estado\n        timestamptz ultima_comunicacao\n        int gerido_por_id FK\n    }\n\n    LEITURAS {\n        bigint id PK\n        varchar sensor_id FK\n        float nivel_enchimento\n        timestamptz data_hora\n    }\n\n    CALIBRACOES {\n        int id PK\n        varchar sensor_id FK\n        int tecnico_id FK\n        timestamptz data\n        text observacoes\n        varchar novo_estado\n    }\n\n    ALERTAS {\n        int id PK\n        varchar contentor_id FK\n        int reconhecido_por_id FK\n        int resolvido_por_id FK\n        varchar tipo\n        timestamptz data\n        text descricao\n        varchar estado\n    }\n\n    ROTAS {\n        int id PK\n        int supervisor_id FK\n        int operador_id FK\n        date data\n        timestamptz hora_inicio\n        timestamptz hora_fim\n        varchar estado\n    }\n\n    PARAGENS {\n        int id PK\n        int rota_id FK\n        varchar contentor_id FK\n        int ordem\n    }\n\n    RECOLHAS {\n        int id PK\n        int paragem_id FK\n        int operador_id FK\n        timestamptz data_hora\n        text observacoes\n    }\n\n    CONFIGURACOES_INTEGRACAO {\n        int id PK\n        varchar endpoint_url\n        int frequencia_sincronizacao_min\n        boolean ativo\n        timestamptz atualizado_em\n    }\n\n    UTILIZADORES ||--o{ UTILIZADORES : \&quot;gere\&quot;\n    UTILIZADORES ||--o{ CONTENTORES : \&quot;gere\&quot;\n    UTILIZADORES ||--o{ SENSORES : \&quot;gere\&quot;\n    UTILIZADORES ||--o{ ROTAS : \&quot;aprova\&quot;\n    UTILIZADORES ||--o{ ROTAS : \&quot;executa\&quot;\n    UTILIZADORES ||--o{ RECOLHAS : \&quot;regista\&quot;\n    UTILIZADORES ||--o{ ALERTAS : \&quot;recebe_e_gere\&quot;\n    UTILIZADORES ||--o{ CALIBRACOES : \&quot;regista\&quot;\n\n    CONTENTORES ||--o{ SENSORES : \&quot;contem\&quot;\n    CONTENTORES ||--o{ ALERTAS : \&quot;envia\&quot;\n    CONTENTORES ||--o{ PARAGENS : \&quot;integra\&quot;\n\n    SENSORES ||--o{ LEITURAS : \&quot;produz\&quot;\n    SENSORES ||--o{ CALIBRACOES : \&quot;sofre\&quot;\n\n    ROTAS ||--|{ PARAGENS : \&quot;tem\&quot;\n    PARAGENS ||--o| RECOLHAS : \&quot;tem\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="s4cPsEj5w0t2HQgDBNPw-1">
