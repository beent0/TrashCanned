# Copy to .env to override the dev defaults used by docker-compose.yml.
POSTGRES_USER=trashcanned
POSTGRES_PASSWORD=trashcanned
POSTGRES_DB=trashcanned

# --- Simulator (KAN-48, decisions doc §7) ---
# Reading interval in real milliseconds.
INTERVAL_MS=5000
# Fill speed multiplier for demos (60 = 1 real minute fills like 1 hour). data_hora stays real time.
SPEED=1
# Per-sensor config. Empty = SENSORS=3 sensors SNS-SIM-001..003 with alternating zones and no passwords.
#   id, zona (turistica|residencial) required; password, taxa_pct_h, silencioso {apos_min, duracao_min} optional.
# SENSORS_JSON=[{"id":"SNS-SIM-001","password":"troca-me","zona":"turistica"},{"id":"SNS-SIM-002","password":"troca-me","zona":"residencial","taxa_pct_h":4},{"id":"SNS-SIM-003","password":"troca-me","zona":"turistica","silencioso":{"apos_min":10,"duracao_min":30}}]
SENSORS_JSON=
# Override or add zones: {"nome":{"taxa_pct_h":N,"picos":[{"de":H,"ate":H,"fator":F}]}} (Azores hours, [de, ate)).
ZONAS_JSON=
